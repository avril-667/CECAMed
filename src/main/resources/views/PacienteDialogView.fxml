<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="640.0" prefHeight="620.0" spacing="16.0" styleClass="main-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>
    <children>
        <!-- Encabezado del diálogo -->
        <VBox spacing="4.0">
            <Label fx:id="lblDialogTitle" text="Registrar Nuevo Paciente" styleClass="title-2"/>
            <Label text="Ingresa los datos personales y el historial clínico del paciente." styleClass="text-muted"/>
        </VBox>

        <Label fx:id="lblError" managed="false" visible="false" styleClass="alert-box, danger-text" wrapText="true"/>

        <!-- Tabs de captura de información -->
        <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Pestaña 1: Datos Personales y Contacto -->
                <Tab text="Datos Generales y Contacto">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                            </padding>
                            <content>
                                <VBox spacing="14.0">
                                    <GridPane hgap="14.0" vgap="12.0">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50.0"/>
                                            <ColumnConstraints percentWidth="50.0"/>
                                        </columnConstraints>
                                        <children>
                                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label text="Nombre(s) *" styleClass="form-label"/>
                                                <TextField fx:id="txtNombre" promptText="Nombre del paciente"/>
                                            </VBox>
                                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label text="Primer Apellido *" styleClass="form-label"/>
                                                <TextField fx:id="txtPrimerApellido" promptText="Apellido paterno"/>
                                            </VBox>

                                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                <Label text="Segundo Apellido" styleClass="form-label"/>
                                                <TextField fx:id="txtSegundoApellido" promptText="Apellido materno"/>
                                            </VBox>
                                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <Label text="Fecha de Nacimiento *" styleClass="form-label"/>
                                                <DatePicker fx:id="dpFechaNacimiento" maxWidth="Infinity"/>
                                            </VBox>

                                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                <Label text="Género *" styleClass="form-label"/>
                                                <ComboBox fx:id="cbGenero" maxWidth="Infinity"/>
                                            </VBox>
                                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                <Label text="CURP" styleClass="form-label"/>
                                                <TextField fx:id="txtCurp" promptText="Clave Única de Registro"/>
                                            </VBox>

                                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                <Label text="Teléfono Principal *" styleClass="form-label"/>
                                                <TextField fx:id="txtTelefono" promptText="10 dígitos"/>
                                            </VBox>
                                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                <Label text="Correo Electrónico" styleClass="form-label"/>
                                                <TextField fx:id="txtEmail" promptText="ejemplo@correo.com"/>
                                            </VBox>
                                        </children>
                                    </GridPane>

                                    <VBox spacing="4.0">
                                        <Label text="Dirección / Domicilio" styleClass="form-label"/>
                                        <TextArea fx:id="txtDireccion" prefRowCount="2" promptText="Calle, número, colonia, ciudad"/>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- Pestaña 2: Antecedentes Médicos -->
                <Tab text="Historial Médico y Alergias">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="content-scroll">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
                            </padding>
                            <content>
                                <VBox spacing="14.0">
                                    <VBox spacing="4.0">
                                        <Label text="⚠️ Alergias Conocidas (Medicamentos, Alimentos, etc.)" styleClass="form-label"/>
                                        <TextArea fx:id="txtAlergias" prefRowCount="2" promptText="Ej: Penicilina, sulfas, látex..."/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                        <Label text="Antecedentes Patológicos (Enfermedades crónicas, cirugías, traumatismos)" styleClass="form-label"/>
                                        <TextArea fx:id="txtAntecedentesPatologicos" prefRowCount="2" promptText="Ej: Diabetes tipo 2, Hipertensión arterial..."/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                        <Label text="Antecedentes No Patológicos (Tabaquismo, alcoholismo, hábitos)" styleClass="form-label"/>
                                        <TextArea fx:id="txtAntecedentesNoPatologicos" prefRowCount="2" promptText="Ej: Tabaquismo ocasional, esquema de vacunación completo..."/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                        <Label text="Antecedentes Heredofamiliares" styleClass="form-label"/>
                                        <TextArea fx:id="txtAntecedentesHeredo" prefRowCount="2" promptText="Ej: Madre con cardiopatía, padre con diabetes..."/>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <!-- Botones de Acción -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button text="Cancelar" onAction="#handleCancelar" styleClass="button-outlined"/>
            <Button fx:id="btnGuardar" text="Guardar Paciente" onAction="#handleGuardar" styleClass="accent, button-action"/>
        </HBox>
    </children>
</VBox>
