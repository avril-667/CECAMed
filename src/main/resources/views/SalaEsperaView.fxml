<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cecarmed.presentation.controller.SalaEsperaController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
    </padding>
    <children>
        <!-- Encabezado de la Sección -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <children>
                <VBox spacing="4.0">
                    <Label text="Monitor de Sala de Espera y Turnos" styleClass="title-1"/>
                    <Label text="Supervisa en tiempo real el flujo de llegada, llamados y tiempos de atención de pacientes." styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <Button text="Refrescar" onAction="#handleRefrescar" styleClass="button-outlined" prefHeight="38.0"/>
                    <Button text="+ Registrar Llegada (Check-In)" onAction="#handleCheckIn"
                            styleClass="accent, button-action" prefHeight="38.0"/>
                </HBox>
            </children>
        </HBox>

        <!-- Tablero de Llamado Actual / Turnero Digital -->
        <VBox spacing="10.0" styleClass="card, call-board">
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="18.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <!-- Turno Destacado -->
                    <VBox alignment="CENTER" prefWidth="120.0" styleClass="turn-display-box">
                        <Label text="TURNO" styleClass="text-caption, text-muted"/>
                        <Label fx:id="lblTurnoLlamado" text="--" styleClass="turn-number-label"/>
                    </VBox>

                    <Separator orientation="VERTICAL" prefHeight="60.0"/>

                    <!-- Información del Paciente y Médico -->
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="PACIENTE LLAMADO A CONSULTA:" styleClass="text-caption, text-muted"/>
                        <Label fx:id="lblPacienteLlamado" text="Sin llamados activos" styleClass="title-2"/>
                        <HBox spacing="16.0" alignment="CENTER_LEFT">
                            <Label fx:id="lblMedicoLlamado" text="" styleClass="text-muted, form-label"/>
                            <Label fx:id="lblHoraLlamado" text="" styleClass="text-muted"/>
                        </HBox>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT" spacing="6.0">
                        <ProgressIndicator fx:id="progressSala" prefHeight="22.0" prefWidth="22.0" visible="false"/>
                        <Label fx:id="lblTotalEnEspera" text="En espera: 0 paciente(s)" styleClass="badge, accent"/>
                    </VBox>
                </HBox>
            </children>
        </VBox>

        <!-- Tabla de Pacientes en Espera -->
        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
            <Label text="COLA DE PACIENTES ACTIVOS EN SALA" styleClass="sidebar-section-title"/>
            <TableView fx:id="tblSalaEspera" VBox.vgrow="ALWAYS" styleClass="striped">
                <columns>
                    <TableColumn fx:id="colTurno" prefWidth="90.0" text="Turno"/>
                    <TableColumn fx:id="colPaciente" prefWidth="240.0" text="Paciente"/>
                    <TableColumn fx:id="colMedico" prefWidth="200.0" text="Médico"/>
                    <TableColumn fx:id="colLlegada" prefWidth="110.0" text="Hora Llegada"/>
                    <TableColumn fx:id="colTiempoEspera" prefWidth="120.0" text="T. Espera"/>
                    <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado"/>
                    <TableColumn fx:id="colAcciones" prefWidth="220.0" text="Acciones"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </children>
</VBox>
