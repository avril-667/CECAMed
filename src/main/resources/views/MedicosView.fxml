<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18.0" styleClass="content-area"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cecarmed.presentation.controller.MedicosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
    </padding>
    <children>
        <!-- Encabezado de la Sección -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <children>
                <VBox spacing="4.0">
                    <Label text="Gestión de Personal Médico" styleClass="title-1"/>
                    <Label text="Consulta, registra y administra los médicos especialistas y profesionales de salud." styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNuevoMedico" text="+ Registrar Nuevo Médico" onAction="#handleNuevoMedico"
                        styleClass="accent, button-action" prefHeight="38.0"/>
            </children>
        </HBox>

        <!-- Barra de Búsqueda y Filtros -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/>
            </padding>
            <children>
                <TextField fx:id="txtSearch" promptText="Buscar por nombre, especialidad, cédula, usuario o teléfono..."
                           HBox.hgrow="ALWAYS" prefHeight="36.0"/>
                <Button fx:id="btnSearch" text="Buscar" onAction="#handleSearch"
                        styleClass="button-outlined" prefHeight="36.0"/>
                <ProgressIndicator fx:id="progressSearch" prefHeight="22.0" prefWidth="22.0" visible="false"/>
                <Region/>
                <Label fx:id="lblTotalResultados" text="Total: 0 médicos" styleClass="text-muted, form-label"/>
            </children>
        </HBox>

        <!-- Tabla de Médicos -->
        <TableView fx:id="tblMedicos" VBox.vgrow="ALWAYS" styleClass="striped">
            <columns>
                <TableColumn fx:id="colCedula" prefWidth="120.0" text="Cédula Prof."/>
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre Completo"/>
                <TableColumn fx:id="colEspecialidad" prefWidth="160.0" text="Especialidad"/>
                <TableColumn fx:id="colUsername" prefWidth="110.0" text="Usuario"/>
                <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Teléfono"/>
                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Correo Electrónico"/>
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado"/>
                <TableColumn fx:id="colAcciones" prefWidth="160.0" text="Acciones"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
