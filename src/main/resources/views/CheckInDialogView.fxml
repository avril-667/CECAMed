<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="520.0" prefHeight="380.0" spacing="16.0" styleClass="main-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>
    <children>
        <VBox spacing="4.0">
            <Label text="Check-In de Sala de Espera" styleClass="title-2"/>
            <Label text="Registra la llegada del paciente para asignarle un turno en tiempo real." styleClass="text-muted"/>
        </VBox>

        <Label fx:id="lblError" managed="false" visible="false" styleClass="alert-box, danger-text" wrapText="true"/>

        <VBox spacing="14.0" VBox.vgrow="ALWAYS">
            <VBox spacing="4.0">
                <Label text="Cita del Día *" styleClass="form-label"/>
                <ComboBox fx:id="cbCitasHoy" maxWidth="Infinity" promptText="Selecciona la cita del paciente..."/>
            </VBox>

            <VBox spacing="4.0">
                <Label text="Observaciones de Llegada" styleClass="form-label"/>
                <TextField fx:id="txtObservaciones" promptText="Ej: Llegó acompañado, refiere malestar general..."/>
            </VBox>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button text="Cancelar" onAction="#handleCancelar" styleClass="button-outlined"/>
            <Button fx:id="btnCheckIn" text="Registrar Llegada" onAction="#handleCheckIn" styleClass="accent, button-action"/>
        </HBox>
    </children>
</VBox>
